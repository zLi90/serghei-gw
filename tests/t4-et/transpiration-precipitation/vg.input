// Input parameters for saturated groundwater flow simulations
// Legal syntax is <key> : <value>
// Lines can end with comments

alpha   : 1.74;1.39        // van Genuchten alpha
n       : 1.3757;1.6024       // van Genuchten n
Ks      : 3.44e-6;5.25e-6   // saturated conductivity (m/s) [1.167e-5, 1.167e-6, 1.167e-7]
Phi     : 0.399;0.339         // porosity (-)
ThetaR  : 0.0001;0.0001       // residual water content (-)
ThetaS  : 0.399;0.339   // saturated water content (-)
