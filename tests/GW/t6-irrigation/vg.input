// Input parameters for saturated groundwater flow simulations
// Legal syntax is <key> : <value>
// Lines can end with comments

alpha   : 0.6;0.4;0.5;0.6        // van Genuchten alpha
n       : 1.609;1.385;1.506;1.568       // van Genuchten n
Ks      : 1.83e-6;3.09e-6;2.35e-6;2.16e-6   // saturated conductivity (m/s) [1.167e-5, 1.167e-6, 1.167e-7]
Phi     : 0.401;0.511;0.449;0.481        // porosity (-)
ThetaR  : 0.043;0.058;0.057;0.055       // residual water content (-)
ThetaS  : 0.401;0.511;0.449;0.481   // saturated water content (-)
