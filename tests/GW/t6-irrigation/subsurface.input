// Input parameters for saturated groundwater flow simulations
// Legal syntax is <key> : <value>
// Lines can end with comments

height : 1.2          // Thickness of the subsurface domain
dz_multiplier : 1.0		// Non-uniform dz
ndepth  : 120          // Number of cells in z-direction.
nSoilID : 4           // Number of soil types
initialMode : 3        // saturated(1), file-h(2), file-theta(3), file-wt(4)
dt_init : 0.001          // initial (also minimum) dt for subsurface
dt_max  : 20.0          // maximum allowable dt
gw_scheme : 2           // numerical schemes, 1:PCA, 2:Picard
async : 0				// Asynchronous coupling
aev : 0.0

// [*]: Recognized boundary conditions are TRANSMISSIVE, REFLECTIVE or PERIODIC
