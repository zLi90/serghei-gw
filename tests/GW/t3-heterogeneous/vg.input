// Input parameters for saturated groundwater flow simulations
// Legal syntax is <key> : <value>
// Lines can end with comments

alpha   : 2.8;1.04        // van Genuchten alpha
n       : 2.239;1.395       // van Genuchten n
Ks      : 6.26e-5;1.52e-6   // saturated conductivity (m/s) [1.167e-5, 1.167e-6, 1.167e-7]
Phi     : 0.3658;0.4686        // porosity (-)
ThetaR  : 0.029;0.106       // residual water content (-)
ThetaS  : 0.3658;0.4686   // saturated water content (-)
