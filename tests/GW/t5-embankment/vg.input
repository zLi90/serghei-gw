// Input parameters for saturated groundwater flow simulations
// Legal syntax is <key> : <value>
// Lines can end with comments

alpha   : 0.873        // van Genuchten alpha
n       : 1.57 //2.544       // van Genuchten n
Ks      : 2.89e-6 //1.0e-5   // saturated conductivity (m/s) [1.167e-5, 1.167e-6, 1.167e-7]
Phi     : 0.37 //0.4        // porosity (-)
ThetaR  : 0.04 //0.0001       // residual water content (-)
ThetaS  : 0.37 //0.4   // saturated water content (-)
