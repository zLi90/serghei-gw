// Input parameters for saturated groundwater flow simulations
// Legal syntax is <key> : <value>
// Lines can end with comments

alpha   : 1.43        // van Genuchten alpha
n       : 1.56       // van Genuchten n
Ks      : 2.89e-6   // saturated conductivity (m/s) [1.167e-5, 1.167e-6, 1.167e-7]
Phi     : 0.33        // porosity (-)
ThetaR  : 0.0       // residual water content (-)
ThetaS  : 0.33   // saturated water content (-)
