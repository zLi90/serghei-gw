// Input parameters for saturated groundwater flow simulations
// Legal syntax is <key> : <value>
// Lines can end with comments

alpha   : 2.8        // van Genuchten alpha
n       : 2.239       // van Genuchten n
Ks      : 2.894e-5   // saturated conductivity (m/s) [1.167e-5, 1.167e-6, 1.167e-7]
Phi     : 0.55        // porosity (-)
ThetaR  : 0.10       // residual water content (-)
ThetaS  : 0.45   // saturated water content (-)
