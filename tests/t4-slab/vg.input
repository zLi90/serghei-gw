// Input parameters for saturated groundwater flow simulations
// Legal syntax is <key> : <value>
// Lines can end with comments

alpha   : 6.0;1.0;1.0       // van Genuchten alpha
n       : 2.0;3.0;3.0       // van Genuchten n
Ks      : 2.70e-3;6.94e-6;2.78e-7  // saturated conductivity (m/s) [1.167e-5, 1.167e-6, 1.167e-7]
Phi     : 0.1;0.1;0.1       // porosity (-)
ThetaR  : 0.02;0.03;0.03      // residual water content (-)
ThetaS  : 0.1;0.1;0.1   // saturated water content (-)
