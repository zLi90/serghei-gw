RT_Aquifer_initialMode : 0        //Initial aquifer phase concentration,0:all zero,1:read initial concentration from file;
RT_Solid_initialMode : 0   //Initial solid phase concentration,0:all zero,1:read initial concentration from file;
ReactionModule : 1      //ReactionModule on(1),ReactionModule off(0)
n_mass : 1               //number of species 
diffusion_molecular: 0           //molecular diffusivity
alpha_L : 0.01            //longitudinal dispersion
alpha_T : 0            //transverse dispersion
rt_scheme : 4            // numerical schemes, 1:PCA, 2:Picard, 3:Eigen3, 4:Gauss_Seidel
Up_Weighting_vplus : 0.5   //Upstream weighting coefficients,[0.5,1]
Up_Weighting_vminus : 0.5  //Upstream weighting coefficients,[0,0.5]
