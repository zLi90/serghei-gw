// Input parameters for saturated groundwater flow simulations
// Legal syntax is <key> : <value>
// Lines can end with comments

alpha   : 7.5        // van Genuchten alpha
n       : 1.89       // van Genuchten n
Ks      : 1.22e-5   // saturated conductivity (m/s) [1.167e-5, 1.167e-6, 1.167e-7]
Phi     : 0.41        // porosity (-)
ThetaR  : 0.065       // residual water content (-)
ThetaS  : 0.41   // saturated water content (-)
