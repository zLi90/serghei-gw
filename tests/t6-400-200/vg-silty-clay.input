// Input parameters for saturated groundwater flow simulations
// Legal syntax is <key> : <value>
// Lines can end with comments

alpha   : 0.5        // van Genuchten alpha
n       : 1.09       // van Genuchten n
Ks      : 5.56e-8   // saturated conductivity (m/s) [1.167e-5, 1.167e-6, 1.167e-7]
Phi     : 0.36        // porosity (-)
ThetaR  : 0.07       // residual water content (-)
ThetaS  : 0.36   // saturated water content (-)
