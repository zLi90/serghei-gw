// Subsurface boundary type for each side
// 1    : no flow
// 2    : uniform head
// 3    : uniform flux
// 4    : non-uniform head, need to read from input file
// 5    : non-uniform head from the surface domain, this only applies to the top surface
bctype-xp : 4
bctype-xm : 4
bctype-yp : 1
bctype-ym : 1
bctype-zp : 1
bctype-zm : 5
// boundary head
hbc-xp : 0.0
hbc-xm : 0.0
hbc-yp : 0.0
hbc-ym : 0.0
hbc-zp : 0.0
hbc-zm : 0.0
// boundary flux
qbc-xp : 0.0
qbc-xm : 0.0
qbc-yp : 0.0
qbc-ym : 0.0
qbc-zp : 0.0
qbc-zm : 0.0
