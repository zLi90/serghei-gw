;;时变河位 + TYPE3 泵站算例 (有泵)

[JUNCTIONS]
;; 列: id  底高程  最大水深  初始水深  超高  积水面积  X(m)  Y(m)  类型  sealed
0	7.0	2.0	0.0	0.0	100.0	20.0	0.0	junction	0
1	7.0	2.0	0.0	0.0	10.0	100.0	0.0	junction	0
2	6.0	3.0	0.0	0.0	100.0	200.0	0.0	outlet	0

[CONDUITS]
;; 列: id  from  to  长度(m)  糙率  进口偏移  出口偏移  初始流量  最大流量  管径(m)
0	1	2	100.0	0.013	0.0	0.0	0.0	0.0	0.60

[PUMPS]
;; 列: id  from  to  curveId  初始开(1/0)  启泵水深(m)  停泵水深(m)
0	0	1	0	1	0.8	0.2

[CURVES]
;; 列: curveId  类型  扬程H(m)  流量Q(m3/s)
0	pump3	0.0	0.100
0	pump3	2.0	0.080
0	pump3	4.0	0.050
0	pump3	6.0	0.000

[OUTFALLS]
;; 列: nodeId  模式  参数(seriesId)  拍门(可选: yes/1 或 no/0)
2	timeseries	0	yes

[RIVERSTAGE]
;; 列: seriesId  时间(s)  水位(m, 绝对高程, 相对 RIV 底 6.0 m)
0	0	6.5
0	3600	6.5

;; ---- 以下为 IDEAL 理想泵算例 (curve 列写 *，无需 [CURVES]) ----
;;
;; [PUMPS]
;; 0	0	1	*	0	0.8	0.2
;;
;; 与 SWMM 一致: 出口流量 = 上游节点 inflow + overflow，不受扬程曲线限制。
