;; ============================================================
;; Case 3: wet well + TYPE3 pump + time-varying river stage (backwater)
;; rainfall -> manhole J1 -> pipe C0 -> wet well S0 -> pump P0 -> outfall O2 (TIMESERIES)
;; Demonstrates: time-varying river; high river raises head and reduces pump flow
;; ============================================================

[STORAGE]
;; cols: id  invert_elev  max_depth  init_depth  shape  p1  p2  p3  sur_depth  ponded_area  X(m)  Y(m)
0  5.0  3.0  0.0  FUNCTIONAL  25.0  0.0  0.0  0.0  0.0  150.0  0.0

[JUNCTIONS]
;; cols: id  invert_elev  max_depth  init_depth  sur_depth  ponded_area  X(m)  Y(m)  type  sealed
1  7.0  2.0  0.0  0.0  300.0   50.0  0.0  junction  0
2  6.5  2.5  0.0  0.0  100.0  250.0  0.0  outlet    0

[CONDUITS]
;; manhole (1, invert 7.0) -> wet well (0, invert 5.0)
0  1  0  80.0  0.013  0.0  0.0  0.0  0.0  0.50

[PUMPS]
;; wet well (0) -> outfall (2); starts >0.4 m, stops <0.15 m
0  0  2  0  0  0.4  0.15

[CURVES]
;; curve ends at 2.5 m head with zero flow (the higher the head, the lower the flow)
0  pump3  0.0  0.50
0  pump3  1.0  0.40
0  pump3  2.0  0.25
0  pump3  2.5  0.000

[OUTFALLS]
;; TIMESERIES param is the series number in [RIVERSTAGE]
2  TIMESERIES  0  no

[RIVERSTAGE]
;; cols: seriesId  time(s)  absolute_stage(m); low tide 6.5 -> high tide 8.5 -> back to 6.5
0  0     6.5
0  1200  8.5
0  2400  6.5
0  3600  6.5
